{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lite Note",
  "mainBinaryName": "lite-note",
  "identifier": "com.liubs.idea-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Lite Note",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../scripts/lite-note-mcp.py": "lite-note-mcp.py" },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Lite Note Markdown Document",
        "description": "Markdown files",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Lite Note Plain Text Document",
        "description": "Plain text files",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}


